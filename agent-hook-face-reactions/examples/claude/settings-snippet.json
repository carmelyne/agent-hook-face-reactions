{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.agents/tablet-face/facectl.sh happy claude"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.agents/tablet-face/facectl.sh thinking claude"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.agents/tablet-face/facectl.sh happy claude"
          }
        ]
      }
    ]
  }
}
